{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on Monday"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Kotlin, KSP, and Compose Compiler must stay compatible — update together",
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin/",
        "com.google.devtools.ksp"
      ],
      "groupName": "Kotlin & KSP"
    },
    {
      "description": "Android Gradle Plugin",
      "matchPackageNames": [
        "/^com\\.android\\.tools\\.build:gradle/"
      ],
      "groupName": "Android Gradle Plugin"
    },
    {
      "description": "Room — all three version refs must stay in sync",
      "matchPackageNames": [
        "/^androidx\\.room/"
      ],
      "groupName": "Room"
    },
    {
      "description": "AndroidX Lifecycle / ViewModel",
      "matchPackageNames": [
        "/^androidx\\.lifecycle/"
      ],
      "groupName": "AndroidX Lifecycle"
    },
    {
      "description": "AndroidX DataStore",
      "matchPackageNames": [
        "/^androidx\\.datastore/"
      ],
      "groupName": "AndroidX DataStore"
    },
    {
      "description": "Koin dependency injection",
      "matchPackageNames": [
        "/^io\\.insert-koin/"
      ],
      "groupName": "Koin"
    },
    {
      "description": "Firebase and Google Services",
      "matchPackageNames": [
        "/^com\\.google\\.firebase/",
        "/^com\\.google\\.gms/"
      ],
      "groupName": "Firebase & Google Services"
    },
    {
      "description": "GitHub Actions — group all action updates into one PR",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ],
  "gradle": {
    "enabled": true
  }
}
